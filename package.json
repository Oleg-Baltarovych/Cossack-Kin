{
  "name": "cossack-kin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm sprites && pnpm luts && vite",
    "sprites": "node tools/build-sprites.ts",
    "sprites:sheet": "node tools/contact-sheet.ts",
    "sprites:strip": "node tools/anim-strip.ts",
    "luts": "node tools/build-luts.ts",
    "balance": "node tools/balance-sim.ts",
    "build": "pnpm sprites && pnpm luts && vite build",
    "preview": "vite preview",
    "check:dist": "node tools/check-dist.ts",
    "security": "pnpm audit --prod --audit-level high && pnpm check:dist",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "break_eternity.js": "2.2.2",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "jsdom": "30.1.3",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
