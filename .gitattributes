* text=auto eol=lf

# Binary art / audio / fonts — no line-ending conversion, no textual diff
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.ico binary
*.aseprite binary
*.ase binary
*.ogg binary
*.m4a binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
